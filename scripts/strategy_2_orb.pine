//@version=6
indicator("ORB + FVG + Sweep  [SPY Only]",
     overlay          = true,
     max_boxes_count  = 50,
     max_labels_count = 50,
     max_lines_count  = 50)

// ╔══════════════════════════════════════════════════════════════╗
// ║  INPUTS                                                      ║
// ╚══════════════════════════════════════════════════════════════╝
var string G1 = "ORB Settings"
orb_minutes = input.int(15, "Opening Range (minutes)", group=G1, minval=5, maxval=30)

var string G2 = "Filters"
rvol_min      = input.float(1.5, "Min RVOL (buy)",  group=G2)
rvol_min_sell = input.float(0.8, "Min RVOL (sell)", group=G2)
swing_len     = input.int(5,     "Sweep Lookback",  group=G2)

var string G3 = "Visuals"
show_fvg  = input.bool(true, "Show FVG Zones",   group=G3)
show_tbl  = input.bool(true, "Show Status Table", group=G3)

// ╔══════════════════════════════════════════════════════════════╗
// ║  SPY GUARD  — alerts only valid on SPY                       ║
// ╚══════════════════════════════════════════════════════════════╝
is_spy = syminfo.ticker == "SPY"
if barstate.islast and not is_spy
    _msg = "This strategy is designed for SPY only. Current chart: " + syminfo.ticker
    label.new(bar_index, high, _msg, style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.normal)

// ╔══════════════════════════════════════════════════════════════╗
// ║  TIME WINDOWS                                                ║
// ╚══════════════════════════════════════════════════════════════╝
open_min   = 930
close_min  = open_min + orb_minutes

open_h     = open_min / 100
open_m     = open_min - open_h * 100
close_h    = close_min / 100
close_m    = close_min - close_h * 100

orb_window = hour == open_h and minute >= open_m and minute < (open_h == close_h ? close_m : 60)
             or (close_h > open_h and hour == close_h and minute < close_m)

// Simplified: hard-code the most common 15-min ORB window
is_opening = not na(time("5", "0930-0945:23456"))
in_hours   = not na(time("5", "0945-1545:23456"))
eod_time   = not na(time("5", "1545-1600:23456"))

// ╔══════════════════════════════════════════════════════════════╗
// ║  OPENING RANGE                                               ║
// ╚══════════════════════════════════════════════════════════════╝
var float orb_high = na
var float orb_low  = na
var bool  orb_set  = false
var line  orb_h_line = na
var line  orb_l_line = na

// Reset at day open
if ta.change(time("D")) != 0
    orb_high    := na
    orb_low     := na
    orb_set     := false

if is_opening
    orb_high := na(orb_high) ? high : math.max(orb_high, high)
    orb_low  := na(orb_low)  ? low  : math.min(orb_low,  low)

// Lock the range as soon as regular-hours bars begin
if in_hours and not orb_set and not na(orb_high)
    orb_set := true
    if not na(orb_h_line)
        line.delete(orb_h_line)
        line.delete(orb_l_line)
    orb_h_line := line.new(bar_index, orb_high, bar_index + 200, orb_high,
        color=color.new(color.green, 20), width=2, style=line.style_dashed)
    orb_l_line := line.new(bar_index, orb_low,  bar_index + 200, orb_low,
        color=color.new(color.red,   20), width=2, style=line.style_dashed)

orb_range = na(orb_high) or na(orb_low) ? na : orb_high - orb_low

// ╔══════════════════════════════════════════════════════════════╗
// ║  CORE INDICATORS                                             ║
// ╚══════════════════════════════════════════════════════════════╝
ema_200  = ta.ema(close, 200)
vwap_val = ta.vwap(hlc3)
atr_val  = ta.atr(14)
rsi_val  = ta.rsi(close, 14)

// ╔══════════════════════════════════════════════════════════════╗
// ║  RELATIVE VOLUME (RVOL)                                      ║
// ╚══════════════════════════════════════════════════════════════╝
vol_avg   = ta.sma(volume, 20)
rvol      = volume / vol_avg
high_rvol      = rvol >= rvol_min
high_rvol_sell = rvol >= rvol_min_sell

// ╔══════════════════════════════════════════════════════════════╗
// ║  FAIR VALUE GAPS (FVG)                                       ║
// ║  A bullish FVG near/below ORB high confirms the breakout     ║
// ║  A bearish FVG near/above ORB low confirms the breakdown     ║
// ╚══════════════════════════════════════════════════════════════╝
fvg_bull = low > high[2]
fvg_bear = high < low[2]

recent_bull_fvg = ta.barssince(fvg_bull) <= 20
recent_bear_fvg = ta.barssince(fvg_bear) <= 20

bull_fvg_bot = ta.valuewhen(fvg_bull, high[2], 0)
bull_fvg_top = ta.valuewhen(fvg_bull, low,     0)
bear_fvg_bot = ta.valuewhen(fvg_bear, high,    0)
bear_fvg_top = ta.valuewhen(fvg_bear, low[2],  0)

// Draw FVG zones as shaded boxes (last 5 per direction)
var box[] bull_boxes = array.new<box>()
var box[] bear_boxes = array.new<box>()

if show_fvg and fvg_bull
    b = box.new(bar_index - 2, low, bar_index + 40, high[2],
        bgcolor      = color.new(color.green, 82),
        border_color = color.new(color.green, 55),
        border_width = 1,
        text         = "Bullish FVG",
        text_color   = color.new(color.green, 20),
        text_size    = size.tiny,
        text_halign  = text.align_left,
        text_valign  = text.align_top)
    array.unshift(bull_boxes, b)
    if array.size(bull_boxes) > 5
        box.delete(array.pop(bull_boxes))

if show_fvg and fvg_bear
    b = box.new(bar_index - 2, low[2], bar_index + 40, high,
        bgcolor      = color.new(color.red, 82),
        border_color = color.new(color.red, 55),
        border_width = 1,
        text         = "Bearish FVG",
        text_color   = color.new(color.red, 20),
        text_size    = size.tiny,
        text_halign  = text.align_left,
        text_valign  = text.align_top)
    array.unshift(bear_boxes, b)
    if array.size(bear_boxes) > 5
        box.delete(array.pop(bear_boxes))

// Extend boxes to current bar
if show_fvg and array.size(bull_boxes) > 0
    for i = 0 to math.min(array.size(bull_boxes) - 1, 4)
        b = array.get(bull_boxes, i)
        box.set_right(b, bar_index + 20)
        if close >= box.get_bottom(b) and close <= box.get_top(b)
            box.set_bgcolor(b, color.new(color.green, 65))

if show_fvg and array.size(bear_boxes) > 0
    for i = 0 to math.min(array.size(bear_boxes) - 1, 4)
        b = array.get(bear_boxes, i)
        box.set_right(b, bar_index + 20)
        if close >= box.get_bottom(b) and close <= box.get_top(b)
            box.set_bgcolor(b, color.new(color.red, 65))

// ╔══════════════════════════════════════════════════════════════╗
// ║  LIQUIDITY SWEEP                                             ║
// ║  Best ORB setup: opposite side swept BEFORE the breakout     ║
// ║  Bull: ORB low swept (stop hunt below), then breaks above    ║
// ║  Bear: ORB high swept (stop hunt above), then breaks below   ║
// ╚══════════════════════════════════════════════════════════════╝
ph = ta.pivothigh(high, swing_len, 1)
pl = ta.pivotlow(low,  swing_len, 1)

last_ph = ta.valuewhen(not na(ph), ph, 0)
last_pl = ta.valuewhen(not na(pl), pl, 0)

bull_sweep    = not na(last_pl) and low < last_pl and close > last_pl
bear_sweep    = not na(last_ph) and high > last_ph and close < last_ph
recent_bull_s = ta.barssince(bull_sweep) <= 10
recent_bear_s = ta.barssince(bear_sweep) <= 10

// ORB-specific sweep: was the opposite side of the range swept (inducement)?
// Pre-compute unconditionally so historical functions always execute every bar
lowest_20  = ta.lowest(low,  20)
highest_20 = ta.highest(high, 20)
orb_low_swept  = orb_set and not na(orb_low)  and lowest_20  < orb_low
orb_high_swept = orb_set and not na(orb_high) and highest_20 > orb_high

// ╔══════════════════════════════════════════════════════════════╗
// ║  ENTRY SIGNALS                                               ║
// ║  ORB breakout + RVOL + SMC confluence (FVG or sweep)         ║
// ╚══════════════════════════════════════════════════════════════╝
smc_bull = recent_bull_fvg or recent_bull_s or orb_low_swept
smc_bear = recent_bear_fvg or recent_bear_s or orb_high_swept

// Pre-compute crossover/crossunder unconditionally so they run every bar
cross_above_orb = ta.crossover(close,  orb_high)
cross_below_orb = ta.crossunder(close, orb_low)

buy_signal  = in_hours and is_spy and orb_set and cross_above_orb and high_rvol      and smc_bull
sell_signal = in_hours and is_spy and orb_set and cross_below_orb and high_rvol_sell and smc_bear

// ╔══════════════════════════════════════════════════════════════╗
// ║  POSITION TRACKING & SL / TP                                 ║
// ║  SL = opposite side of ORB range, TP = 1× range extension   ║
// ╚══════════════════════════════════════════════════════════════╝
var float entry_px = na
var int   position = 0

if buy_signal and position == 0
    entry_px := close
    position := 1
if sell_signal and position == 0
    entry_px := close
    position := -1

sl = position ==  1 ? orb_low  :
     position == -1 ? orb_high : na
tp = position ==  1 ? (na(orb_range) ? na : orb_high + orb_range) :
     position == -1 ? (na(orb_range) ? na : orb_low  - orb_range) : na

hit_sl = not na(sl) and ((position ==  1 and low  <= sl) or (position == -1 and high >= sl))
hit_tp = not na(tp) and ((position ==  1 and high >= tp) or (position == -1 and low  <= tp))
close_signal = position != 0 and (hit_sl or hit_tp or eod_time)

if close_signal
    position := 0
    entry_px := na

// ╔══════════════════════════════════════════════════════════════╗
// ║  PLOTS                                                       ║
// ╚══════════════════════════════════════════════════════════════╝
plot(ema_200,  "EMA 200", color=color.new(color.gray,  30), linewidth=1)
plot(vwap_val, "VWAP",    color=color.new(color.purple, 0), linewidth=2)
plot(orb_high, "ORB High", color=color.new(color.green, 20), linewidth=2, style=plot.style_linebr)
plot(orb_low,  "ORB Low",  color=color.new(color.red,   20), linewidth=2, style=plot.style_linebr)
plot(sl, "SL", color=color.new(color.red,   0), linewidth=1, style=plot.style_linebr)
plot(tp, "TP", color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)

// Macro regime background
bull_regime = close > ema_200
bear_regime = close < ema_200
bgcolor(bull_regime ? color.new(color.green, 96) : na, title="Bull Regime")
bgcolor(bear_regime ? color.new(color.red,   96) : na, title="Bear Regime")

// Sweep markers
plotshape(bull_sweep, "Bull Sweep", shape.triangleup,   location.belowbar,
    color.new(color.aqua,   10), size=size.small, text="SWEEP↑", textcolor=color.aqua)
plotshape(bear_sweep, "Bear Sweep", shape.triangledown, location.abovebar,
    color.new(color.orange, 10), size=size.small, text="SWEEP↓", textcolor=color.orange)

// Signal labels — show what confluence triggered the entry
if buy_signal
    _fvg  = recent_bull_fvg ? "[FVG] " : ""
    _sw   = recent_bull_s or orb_low_swept ? "[SWEEP] " : ""
    _dtl  = "ORB BUY  " + _fvg + _sw + "RVOL " + str.tostring(rvol,"#.#") + "x"
    label.new(bar_index, low, _dtl, style=label.style_label_up, yloc=yloc.belowbar, color=color.new(color.green, 5), textcolor=color.white, size=size.normal)

if sell_signal
    _fvg  = recent_bear_fvg ? "[FVG] " : ""
    _sw   = recent_bear_s or orb_high_swept ? "[SWEEP] " : ""
    _dtl  = "ORB SELL  " + _fvg + _sw + "RVOL " + str.tostring(rvol,"#.#") + "x"
    label.new(bar_index, high, _dtl, style=label.style_label_down, yloc=yloc.abovebar, color=color.new(color.red, 5), textcolor=color.white, size=size.normal)

if close_signal
    _reason = hit_sl ? "SL HIT" : hit_tp ? "TP HIT" : "EOD"
    label.new(bar_index, close, "EXIT - " + _reason, style=label.style_label_down, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)

// ╔══════════════════════════════════════════════════════════════╗
// ║  STATUS TABLE  (top-right, real-time factor dashboard)       ║
// ╚══════════════════════════════════════════════════════════════╝
if show_tbl
    var table tbl = table.new(position.top_right, 2, 14,
        bgcolor      = color.new(color.black, 5),
        frame_color  = color.new(color.gray,  50),
        frame_width  = 1,
        border_color = color.new(color.gray,  70),
        border_width = 1)

    C_HDR  = color.new(#1a1a2e, 0)
    C_PASS = color.new(color.teal,  20)
    C_FAIL = color.new(color.maroon,20)
    C_NEUT = color.new(color.gray,  40)
    C_TXT  = color.white
    SZ     = size.small

    table.cell(tbl, 0, 0, "FACTOR",       bgcolor=C_HDR,  text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 0, "VALUE",        bgcolor=C_HDR,  text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // Ticker guard
    table.cell(tbl, 0, 1, "Ticker",       bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 1, syminfo.ticker, bgcolor=is_spy ? C_PASS : C_FAIL, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // ORB set
    table.cell(tbl, 0, 2, "ORB Set",      bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 2, orb_set ? "✓  " + str.tostring(orb_high,"#.00") + " / " + str.tostring(orb_low,"#.00") : "Waiting 9:30–9:45",
        bgcolor=orb_set ? C_PASS : C_FAIL, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // ORB Range
    table.cell(tbl, 0, 3, "ORB Range",    bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 3, na(orb_range) ? "—" : "$" + str.tostring(orb_range,"#.00"),
        bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // Price vs ORB
    above_orb  = not na(orb_high) and close > orb_high
    below_orb  = not na(orb_low)  and close < orb_low
    price_zone = above_orb ? "Above ORB ▲" : below_orb ? "Below ORB ▼" : "Inside Range"
    price_col  = above_orb ? C_PASS : below_orb ? C_FAIL : C_NEUT
    table.cell(tbl, 0, 4, "Price Zone",   bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 4, price_zone,     bgcolor=price_col, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // RVOL
    table.cell(tbl, 0, 5, "RVOL",         bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 5, str.tostring(rvol,"#.##") + "x", bgcolor=high_rvol ? C_PASS : C_FAIL, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // RSI
    rsi_ok = rsi_val > 40 and rsi_val < 70
    table.cell(tbl, 0, 6, "RSI (14)",     bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 6, str.tostring(rsi_val,"#.0"), bgcolor=rsi_ok ? C_PASS : C_FAIL, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // vs VWAP
    table.cell(tbl, 0, 7, "vs VWAP",      bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 7, close > vwap_val ? "Above" : "Below", bgcolor=close > vwap_val ? C_PASS : C_FAIL, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // Bull FVG
    bs_bull = ta.barssince(fvg_bull)
    bull_fvg_txt = recent_bull_fvg ? str.tostring(bs_bull) + " bars ago" : "None"
    table.cell(tbl, 0, 8, "Bull FVG",     bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 8, bull_fvg_txt, bgcolor=recent_bull_fvg ? C_PASS : C_FAIL, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // Bear FVG
    bs_bear = ta.barssince(fvg_bear)
    bear_fvg_txt = recent_bear_fvg ? str.tostring(bs_bear) + " bars ago" : "None"
    table.cell(tbl, 0, 9, "Bear FVG",     bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 9, bear_fvg_txt, bgcolor=recent_bear_fvg ? C_PASS : C_FAIL, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // Sweep
    any_sweep = recent_bull_s or recent_bear_s or orb_low_swept or orb_high_swept
    orb_sw    = orb_low_swept ? "ORB Low Swept" : orb_high_swept ? "ORB High Swept" : ""
    gen_sw    = recent_bull_s ? "Bull ↑" : recent_bear_s ? "Bear ↓" : ""
    sweep_val = any_sweep ? (orb_sw != "" ? orb_sw : gen_sw) : "None"
    table.cell(tbl, 0, 10, "Liq Sweep",   bgcolor=C_NEUT, text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 10, sweep_val,     bgcolor=any_sweep ? C_PASS : C_FAIL, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // Divider
    table.cell(tbl, 0, 11, "──────────────", bgcolor=C_HDR, text_color=color.new(color.gray,30), text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 11, "──────────",     bgcolor=C_HDR, text_color=color.new(color.gray,30), text_size=SZ, text_halign=text.align_center)

    // Overall signal
    sig_txt = buy_signal ? "▲ ORB BUY" : sell_signal ? "▼ ORB SELL" : "WAITING"
    sig_col = buy_signal ? C_PASS      : sell_signal ? C_FAIL       : C_NEUT
    table.cell(tbl, 0, 12, "SIGNAL",      bgcolor=C_HDR,   text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 12, sig_txt,       bgcolor=sig_col, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

    // Macro regime
    regime_txt = bull_regime ? "BULL (>200 EMA)" : "BEAR (<200 EMA)"
    regime_col = bull_regime ? C_PASS : C_FAIL
    table.cell(tbl, 0, 13, "Regime",      bgcolor=C_HDR,   text_color=C_TXT, text_size=SZ, text_halign=text.align_left)
    table.cell(tbl, 1, 13, regime_txt,    bgcolor=regime_col, text_color=C_TXT, text_size=SZ, text_halign=text.align_center)

// ╔══════════════════════════════════════════════════════════════╗
// ║  ALERTS  — condition: "Any alert() function call"            ║
// ╚══════════════════════════════════════════════════════════════╝
if buy_signal
    alert('{"secret":"mysecret123","symbol":"SPY","price":' + str.tostring(close,'#.00') + ',"timeframe":"5m","strategy":"orb","signal":"buy"}',   alert.freq_once_per_bar_close)
if sell_signal
    alert('{"secret":"mysecret123","symbol":"SPY","price":' + str.tostring(close,'#.00') + ',"timeframe":"5m","strategy":"orb","signal":"sell"}',  alert.freq_once_per_bar_close)
if close_signal
    alert('{"secret":"mysecret123","symbol":"SPY","price":' + str.tostring(close,'#.00') + ',"timeframe":"5m","strategy":"orb","signal":"close"}', alert.freq_once_per_bar_close)
